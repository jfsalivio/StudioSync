{
  "name": "studiosync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file=.env --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file=.env server/index.js",
    "db:setup": "node scripts/mysql-local.mjs setup",
    "db:start": "node scripts/mysql-local.mjs start",
    "db:stop": "node --env-file=.env scripts/mysql-local.mjs stop",
    "db:seed": "node --env-file=.env server/seed.js",
    "test": "node --env-file=.env --test tests/*.test.js",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "db:backup": "node --env-file=.env scripts/backup.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "bcryptjs": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
